{
  "name": "PermissionChangeRequest",
  "type": "object",
  "properties": {
    "requester_email": {
      "type": "string",
      "description": "Email de quem solicitou"
    },
    "requester_name": {
      "type": "string",
      "description": "Nome de quem solicitou"
    },
    "target_email": {
      "type": "string",
      "description": "Email de quem recebeu a solicita\u00e7\u00e3o"
    },
    "target_name": {
      "type": "string",
      "description": "Nome de quem recebeu a solicita\u00e7\u00e3o"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "page_access",
        "feature_access",
        "role_change",
        "mudanca_role",
        "acesso_pagina",
        "transferencia_lead",
        "suporte_closer",
        "aprovacao_proposta",
        "ferias_folga",
        "equipamento",
        "outro",
        "supervisores",
        "gerentes",
        "relato_bug"
      ],
      "description": "Tipo de solicita\u00e7\u00e3o"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo leg\u00edvel da solicita\u00e7\u00e3o"
    },
    "detail_extra": {
      "type": "string",
      "description": "Detalhe adicional"
    },
    "target_role": {
      "type": "string",
      "enum": [
        "supervisores",
        "admin",
        "gestores"
      ],
      "description": "Para qual grupo a solicita\u00e7\u00e3o foi direcionada (legado)"
    },
    "requested_page": {
      "type": "string",
      "description": "P\u00e1gina solicitada (se aplic\u00e1vel)"
    },
    "requested_feature": {
      "type": "string",
      "description": "Feature solicitada (se aplic\u00e1vel)"
    },
    "requested_role": {
      "type": "string",
      "description": "Role solicitada (se aplic\u00e1vel)"
    },
    "justification": {
      "type": "string",
      "description": "Justificativa da solicita\u00e7\u00e3o"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs dos anexos enviados com a solicita\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "cancelled"
      ],
      "default": "pending",
      "description": "Status da solicita\u00e7\u00e3o"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Email de quem revisou"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data da revis\u00e3o"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Motivo da rejei\u00e7\u00e3o"
    },
    "response_note": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o da resposta"
    },
    "response_attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs dos anexos enviados na resposta (aprova\u00e7\u00e3o/rejei\u00e7\u00e3o)"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data do cancelamento pelo solicitante"
    },
    "sla_hours": {
      "type": "number",
      "description": "SLA em horas"
    },
    "prazo_atendimento": {
      "type": "string",
      "format": "date-time",
      "description": "Prazo limite para atendimento"
    },
    "created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data de cria\u00e7\u00e3o"
    },
    "updated_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima atualiza\u00e7\u00e3o"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forwarded_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "response_time_minutes": {
      "type": "number"
    }
  },
  "required": [
    "requester_email",
    "request_type",
    "justification"
  ]
}