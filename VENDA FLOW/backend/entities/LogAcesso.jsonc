{
  "name": "LogAcesso",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "user_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio"
    },
    "empresaId": {
      "type": "string",
      "description": "ID da empresa"
    },
    "tipo_evento": {
      "type": "string",
      "enum": [
        "login",
        "logout",
        "pagina_visitada",
        "campanha_conectada",
        "campanha_desconectada",
        "ligacao_iniciada",
        "ligacao_finalizada"
      ],
      "description": "Tipo do evento registrado"
    },
    "pagina": {
      "type": "string",
      "description": "Nome da p\u00e1gina visitada"
    },
    "campanha_id": {
      "type": "string",
      "description": "ID da campanha 3C Plus (se aplic\u00e1vel)"
    },
    "campanha_nome": {
      "type": "string",
      "description": "Nome da campanha (se aplic\u00e1vel)"
    },
    "duracao_segundos": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o do evento em segundos (sess\u00e3o, liga\u00e7\u00e3o etc)"
    },
    "session_id": {
      "type": "string",
      "description": "ID \u00fanico da sess\u00e3o de uso"
    },
    "ip": {
      "type": "string",
      "description": "IP do usu\u00e1rio (se dispon\u00edvel)"
    },
    "user_agent": {
      "type": "string",
      "description": "Browser/dispositivo"
    },
    "registrado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do evento"
    }
  },
  "required": [
    "user_email",
    "tipo_evento",
    "registrado_em"
  ]
}