{
  "name": "ProfileTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do template"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do template"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "gestor",
        "sdr",
        "closer"
      ],
      "description": "Role do template"
    },
    "permissions": {
      "type": "object",
      "description": "Permiss\u00f5es do template",
      "properties": {
        "pages": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "read": {
                "type": "boolean"
              },
              "create": {
                "type": "boolean"
              },
              "update": {
                "type": "boolean"
              },
              "delete": {
                "type": "boolean"
              }
            }
          }
        },
        "features": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      }
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "Template padr\u00e3o para a role"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "role"
  ]
}