{
  "name": "CategoriaProduto",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da categoria"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da categoria"
    },
    "cor": {
      "type": "string",
      "description": "Cor da categoria (hex)",
      "default": "#3b82f6"
    },
    "ativa": {
      "type": "boolean",
      "default": true,
      "description": "Status da categoria"
    }
  },
  "required": [
    "nome"
  ]
}