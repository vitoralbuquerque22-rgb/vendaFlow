{
  "name": "LeadScore",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "ID do lead"
    },
    "lead_nome": {
      "type": "string",
      "description": "Nome do lead (para facilitar busca)"
    },
    "score_total": {
      "type": "number",
      "default": 0,
      "description": "Score total (0-100)"
    },
    "score_perfil": {
      "type": "number",
      "default": 0,
      "description": "Score de perfil (0-40)"
    },
    "score_engajamento": {
      "type": "number",
      "default": 0,
      "description": "Score de engajamento (0-60)"
    },
    "score_comportamento": {
      "type": "number",
      "default": 0,
      "description": "Score de comportamento (0-30)"
    },
    "temperatura": {
      "type": "string",
      "enum": [
        "quente",
        "morno",
        "frio"
      ],
      "default": "frio",
      "description": "Temperatura do lead"
    },
    "detalhes_pontuacao": {
      "type": "object",
      "description": "Detalhamento da pontua\u00e7\u00e3o",
      "properties": {
        "formulario_completo": {
          "type": "boolean",
          "default": false
        },
        "cargo_decisor": {
          "type": "boolean",
          "default": false
        },
        "empresa_adequada": {
          "type": "boolean",
          "default": false
        },
        "produto_definido": {
          "type": "boolean",
          "default": false
        },
        "total_cliques": {
          "type": "number",
          "default": 0
        },
        "respondeu_email": {
          "type": "boolean",
          "default": false
        },
        "reuniao_agendada": {
          "type": "boolean",
          "default": false
        },
        "reuniao_realizada": {
          "type": "boolean",
          "default": false
        },
        "lead_aquecido": {
          "type": "boolean",
          "default": false
        },
        "multiplas_interacoes": {
          "type": "boolean",
          "default": false
        },
        "interesse_multiplos_produtos": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "historico_scores": {
      "type": "array",
      "description": "Hist\u00f3rico de mudan\u00e7as de score",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "score_anterior": {
            "type": "number"
          },
          "score_novo": {
            "type": "number"
          },
          "motivo": {
            "type": "string"
          },
          "acao": {
            "type": "string"
          }
        }
      }
    },
    "ultima_atualizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima atualiza\u00e7\u00e3o do score"
    }
  },
  "required": [
    "lead_id"
  ]
}