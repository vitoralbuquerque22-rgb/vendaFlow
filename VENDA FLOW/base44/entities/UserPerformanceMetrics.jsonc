{
  "name": "UserPerformanceMetrics",
  "type": "object",
  "properties": {
    "empresaId": {
      "type": "string",
      "description": "ID da empresa (tenant)"
    },
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio \u2014 \u00fanico por empresa"
    },
    "score_qualidade": {
      "type": "number",
      "description": "M\u00e9dia ponderada dos feedbacks \u2014 peso 40%",
      "default": 0
    },
    "score_performance": {
      "type": "number",
      "description": "Convers\u00e3o + volume de liga\u00e7\u00f5es \u2014 peso 35%",
      "default": 0
    },
    "score_consistencia": {
      "type": "number",
      "description": "Dias ativos no m\u00eas \u2014 peso 15%",
      "default": 0
    },
    "score_desenvolvimento": {
      "type": "number",
      "description": "Treinamentos conclu\u00eddos \u2014 peso 10%",
      "default": 0
    },
    "score_final": {
      "type": "number",
      "description": "Score h\u00edbrido final (f\u00f3rmula ponderada)",
      "default": 0
    },
    "score_visivel": {
      "type": "boolean",
      "description": "S\u00f3 true ap\u00f3s m\u00ednimo de 3 feedbacks \u2014 evita ranking prematuro",
      "default": false
    },
    "pontuacao_mes_atual": {
      "type": "number",
      "description": "Score do m\u00eas corrente \u2014 leaderboard mensal",
      "default": 0
    },
    "total_feedbacks": {
      "type": "number",
      "description": "Total hist\u00f3rico de feedbacks recebidos",
      "default": 0
    },
    "feedbacks_mes_atual": {
      "type": "number",
      "description": "Feedbacks recebidos no m\u00eas corrente",
      "default": 0
    },
    "feedbacks_contestados": {
      "type": "number",
      "description": "Total de contesta\u00e7\u00f5es \u2014 detector de vi\u00e9s do avaliador",
      "default": 0
    },
    "avaliadores_unicos": {
      "type": "number",
      "description": "Quantidade de avaliadores distintos \u2014 detector de vi\u00e9s",
      "default": 0
    },
    "melhor_categoria": {
      "type": "string",
      "description": "Categoria com maior pontua\u00e7\u00e3o m\u00e9dia"
    },
    "treinamentos_assistidos": {
      "type": "number",
      "description": "Total de treinamentos conclu\u00eddos",
      "default": 0
    },
    "ultima_atualizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o cache foi recalculado"
    }
  },
  "required": [
    "empresaId",
    "user_email"
  ]
}