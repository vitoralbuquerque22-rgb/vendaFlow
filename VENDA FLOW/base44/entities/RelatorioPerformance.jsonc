          "type": "number"
        },
        "totalAtividades": {
          "type": "number"
        },
        "totalLigacoes": {
          "type": "number"
        },
        "ligacoesAtendidas": {
          "type": "number"
        },
        "taxaAtendimento": {
          "type": "number"
        },
