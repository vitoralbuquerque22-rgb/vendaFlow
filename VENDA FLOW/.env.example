# Copie este arquivo para .env e preencha os valores.

# ---------- Frontend (Vite) ----------
VITE_BASE44_APP_ID=vendaflow
VITE_BASE44_APP_BASE_URL=
# Para onde o Vite encaminha /api em desenvolvimento
VITE_API_PROXY=http://localhost:8000

# ---------- API ----------
APP_ID=vendaflow
# Gere uma chave longa e aleatória (ex: openssl rand -hex 32)
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
# Endereço onde o sistema é acessado (usado em links de e-mail e arquivos)
PUBLIC_URL=http://localhost:5173
POSTGRES_PASSWORD=vendaflow

# Primeiro administrador (criado só se o banco estiver vazio)
ADMIN_EMAIL=admin@vendaflow.local
ADMIN_PASSWORD=troque-esta-senha
# E-mails que viram admin ao se cadastrar (separados por vírgula)
ADMIN_EMAILS=
ALLOW_SIGNUP=true

# ---------- IA (Claude) ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# "default" = se o modelo recusar por política, a API tenta outro modelo automaticamente. "off" desliga.
CLAUDE_FALLBACKS=default

# ---------- E-mail ----------
# Em desenvolvimento o Mailpit (docker compose) captura tudo em http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VendaFlow <nao-responda@vendaflow.local>

# ---------- Segredos usados pelas funções ----------
# Chave para criptografar tokens do 3C Plus (AES-256-GCM, 32 bytes em base64)
TOKEN_ENCRYPTION_KEY=
BRIDGE_WEBHOOK_SECRET=
INTERNAL_API_SECRET=
# Transcrição de áudio (função transcreverAudio usa a OpenAI Whisper)
OPENAI_API_KEY=
